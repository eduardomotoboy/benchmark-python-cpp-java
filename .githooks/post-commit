#!/bin/sh
# ==============================================================================
# AUTOMAÇÃO DE ATUALIZAÇÃO DO DOCKER VIA GIT HOOK (post-commit)
# Objetivo: Toda vez que você executar 'git commit', este script roda
# automaticamente, reconstruindo a imagem e reiniciando o container Docker.
# ==============================================================================

echo ""
echo "=========================================================="
echo "🔄 [Git Hook] Commit detectado!"
echo "🐳 Iniciando atualizacao automatica do container Docker..."
echo "=========================================================="

# 1. Para e remove o container anterior (caso esteja rodando)
echo "⏹️  1/3. Parando versão anterior do container..."
docker rm -f benchmark-calc >/dev/null 2>&1 || true

# 2. Reconstrói a imagem Docker com os novos arquivos
echo "🔨 2/3. Reconstruindo imagem 'benchmark-calc' com as novas alterações..."
docker build -t benchmark-calc .

# 3. Liga o novo container em segundo plano na porta 5000
echo "🚀 3/3. Inicializando novo container na porta 5000..."
docker run -d -p 5000:5000 --name benchmark-calc benchmark-calc

echo ""
echo "=========================================================="
echo "✅ Container Docker atualizado com sucesso!"
echo "🌐 Acesse: http://localhost:5000"
echo "=========================================================="
echo ""
